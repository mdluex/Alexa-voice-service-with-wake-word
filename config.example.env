# Copy to config.env (or /etc/pi-voice-assistant/config.env) and edit.
# Never commit real secrets. Prefer ./install.sh which writes this for you.

# Wake-word engine: openwakeword (default, free/open) or porcupine (paid AccessKey)
WAKE_ENGINE=openwakeword

# Built-in openWakeWord models: alexa, hey_jarvis, hey_mycroft, okay_nabu, hey_rhasspy
WAKE_MODEL=alexa
WAKE_THRESHOLD=0.5
WAKE_COOLDOWN_SECONDS=2.0

# Optional: path to a custom .tflite openWakeWord model
# OPENWAKEWORD_MODEL_PATH=/home/pi/models/my_wakeword.tflite

# Microphone device index or name from: python -m pi_voice_assistant --list-audio-devices
# AUDIO_DEVICE=1
SAMPLE_RATE=16000

# Default backend: real Amazon Alexa via AVS Device SDK SampleApp
BACKEND=avs
AVS_START_SCRIPT=/home/pi/avs-sdk/startsample.sh
# AVS_WORKING_DIRECTORY=/home/pi/avs-sdk
# AVS_LOG_DIRECTORY=/home/pi/avs-sdk/logs

# Startup chime
PLAY_STARTUP_SOUND=true
# STARTUP_SOUND=/opt/pi-voice-assistant/assets/startup.wav

# --- Optional non-Alexa fallback (not the default) ---
# BACKEND=conversation
# LISTEN_SECONDS=5.0
# TTS_COMMAND=espeak-ng
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Shell command backend ---
# BACKEND=command
# SHELL_COMMAND=/usr/local/bin/on-wake.sh

# --- Optional Porcupine (requires paid AccessKey; free tier ended 2026-06-30) ---
# WAKE_ENGINE=porcupine
# PORCUPINE_ACCESS_KEY=
# PORCUPINE_KEYWORD_PATHS=/path/to/keyword_raspberry-pi.ppn
# PORCUPINE_SENSITIVITIES=0.6
